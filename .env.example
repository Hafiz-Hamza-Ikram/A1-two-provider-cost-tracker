# Google Gemini configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_id
GEMINI_INPUT_PRICE_PER_M=0.0
GEMINI_OUTPUT_PRICE_PER_M=0.0

